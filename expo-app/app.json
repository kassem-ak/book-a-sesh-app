{
  "expo": {
    "name": "BOOK'D",
    "slug": "bookd",
    "owner": "akkass",
    "description": "Book coaches, courts, communities, and partner-store gear in one app.",
    "githubUrl": "https://github.com/kassem-ak/book-a-sesh-app",
    "scheme": "bookd",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.bookd.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bookd.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BOOK'D to access a photo you choose for your public profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withBookdAndroid",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BOOK'D to use your location while the app is open so it can show how far away coaches and partners are. You choose whether other members see a pin or only your approximate area, and you can turn this off at any time."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0D0E11"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C6F24E",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/"
    }
  }
}
