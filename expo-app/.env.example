# Copy to .env and fill from Supabase → Project Settings → API.
# EXPO_PUBLIC_* vars are inlined into the app at build time.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The map defaults to CARTO's keyless dark/light OSM basemaps. To use
# a provider that needs a key, put the key in the URL and restrict it by HTTP
# referrer in that provider's dashboard -- EXPO_PUBLIC_* values are inlined into
# the published bundle and are readable by anyone who opens it.
# EXPO_PUBLIC_MAP_TILES_DARK=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILES_LIGHT=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Native builds only (iOS/Android). Unset, the native map falls back to the
# raster tile map, so the map works either way. Read at build time by
# app.config.js AND at runtime to choose the renderer, hence EXPO_PUBLIC_.
# Restrict it by package/bundle id + SHA-1 in the Google Cloud console: a Maps
# key is extractable from any APK, so restriction is the protection.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
